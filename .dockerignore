# Secrets — never bake these into an image layer
.env
.env.*
!.env.example
!.env.prod.example
!.env.test.example

# Real DB dumps and Let's Encrypt private keys on the prod server.
# These don't exist in this repo checkout, but docker-compose.prod.yml
# bind-mounts them and scripts/backup.sh populates them on the actual
# server — exclude them so a `docker build` run from that same working
# directory can never bake a real backup or TLS key into an image layer.
backups/
certbot/

# VCS / tooling
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Frontend (Dockerfile.frontend copies frontend/ separately)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Django runtime artifacts
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# OS
.DS_Store
