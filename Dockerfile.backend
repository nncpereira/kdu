# ------------------------------------------------------------------
# Stage 1: build dependencies
# ------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements/prod.txt ./
RUN pip install --no-cache-dir --prefix=/install -r prod.txt


# ------------------------------------------------------------------
# Stage 2: runtime
# ------------------------------------------------------------------
FROM python:3.12-slim AS production

# Overridable so a non-prod compose file (e.g. docker-compose.test.yml)
# can collectstatic against a different settings module at build time.
# MUST default to prod: docker-compose.prod.yml doesn't pass this build
# arg, so whatever default is here is what a real prod build silently
# gets. docker-compose.test.yml passes kdu.settings.staging explicitly.
ARG DJANGO_SETTINGS_MODULE=kdu.settings.prod

# Build-time-only placeholder so `collectstatic` doesn't trip prod.py's
# "DJANGO_SECRET_KEY must be set" guard (collectstatic never touches
# crypto, so this value doesn't need to be real). The actual secret
# always comes from env_file at container runtime, which overrides
# this baked-in default — see docker-compose.prod.yml / .env.prod.
ARG DJANGO_SECRET_KEY=build-dummy-key-not-used-at-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=${DJANGO_SETTINGS_MODULE} \
    DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}

WORKDIR /app

# Runtime system libraries only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Non-root user
RUN useradd -m -r appuser && \
    mkdir -p /app/staticfiles /app/media && \
    chown -R appuser:appuser /app

USER appuser

# Application code
COPY --chown=appuser:appuser . .

# Collect static at build time
RUN python manage.py collectstatic --noinput --clear

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

CMD ["gunicorn", "kdu.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--threads", "2", \
     "--timeout", "60", \
     "--graceful-timeout", "30", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]