# Local Docker test environment — copy to .env.test and fill in.
# This is NOT read by your native local dev setup (that uses .env) and
# NOT read by production (that uses .env.prod). It only applies inside
# docker-compose.test.yml.

# Django
DJANGO_SECRET_KEY=generate-a-random-string-for-local-test-use
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Database — a separate Postgres container/volume from your native dev
# DB and from prod. POSTGRES_HOST=db is the Compose service name; the
# port below (5432) is the container-internal port, not the host port
# (docker-compose.test.yml maps the host side to 5433 to avoid clashing
# with your native Postgres on 5432).
POSTGRES_DB=kdu_test
POSTGRES_USER=kdu
POSTGRES_PASSWORD=kdu_test
POSTGRES_HOST=db
POSTGRES_PORT=5432
