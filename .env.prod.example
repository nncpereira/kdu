# Django
DJANGO_SECRET_KEY=generate-a-50-char-random-string-here
DJANGO_DEBUG=0
# localhost,127.0.0.1 are required here, not optional: the backend
# container's own Docker healthcheck curls itself at
# http://localhost:8000/health/, bypassing nginx entirely, and that
# request's Host header must pass this check or the container (and
# everything depends_on'ing its health, e.g. frontend) never comes up.
DJANGO_ALLOWED_HOSTS=kdu.example.com,www.kdu.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://kdu.example.com,https://www.kdu.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://kdu.example.com

# Database
POSTGRES_DB=kdu
POSTGRES_USER=kdu
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email (optional, for password reset emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@kdu.example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1